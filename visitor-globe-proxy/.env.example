# Copy this file's variables into the Vercel project's Environment Variables
# settings (Project -> Settings -> Environment Variables) -- do not commit a
# real .env file.

UMAMI_API_URL=https://api.umami.is
UMAMI_WEBSITE_ID=your-umami-website-id

# Umami Cloud auth (use this, leave username/password blank):
UMAMI_API_KEY=your-umami-cloud-api-key

# Self-hosted Umami auth instead (use this pair, leave UMAMI_API_KEY blank,
# and set UMAMI_API_URL to your own instance's URL):
# UMAMI_USERNAME=
# UMAMI_PASSWORD=
